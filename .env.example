# GEMINI_API_KEY: Optional fallback key for Gemini AI API calls when Vertex AI is disabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Vertex AI & GCP / Firebase Configuration
USE_VERTEX_AI=true
GCP_PROJECT_ID="care-recall"
GCP_LOCATION="us-central1"
GEMINI_MODEL="gemini-2.5-flash"

